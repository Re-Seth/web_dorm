# คัดลอกเป็น .env แล้วแก้ค่า (start.js สร้างให้อัตโนมัติพร้อมสุ่ม JWT_SECRET)
DATABASE_URL="file:./dev.db"

# ต้องตั้งเสมอ อย่างน้อย 16 ตัวอักษร — สร้างได้ด้วย: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=

# origin ของ frontend ที่อนุญาตให้เรียก API (คั่นด้วย ,)
CORS_ORIGIN=http://localhost:5173,http://localhost:8080

# บัญชีผู้ดูแลสำหรับ npm run seed
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_EMAIL=admin@example.com

# รอบเปิดรับลงทะเบียน (ISO 8601 พร้อมเขตเวลา)
# REG_TERM=ภาคเรียนที่ 2/2569
# REG_OPEN_AT=2026-10-17T00:00:00+07:00
# REG_CLOSE_AT=2026-10-20T23:59:59+07:00

# ปุ่มเข้าสู่ระบบด้วยบัญชีทดลอง (ผู้เช่า / Admin) บนหน้า login — เปิดเฉพาะเว็บทดสอบ ห้ามเปิดบนระบบจริง
DEMO_LOGIN=false
