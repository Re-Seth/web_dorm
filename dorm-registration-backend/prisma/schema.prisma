generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  email     String   @unique
  password  String
  name      String?
  role      String   @default("USER")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ข้อมูลการใช้ไฟฟ้า (รองรับ Real-time)
model PowerUsage {
  id          Int      @id @default(autoincrement())
  roomId      Int
  voltage     Float    // แรงดันไฟฟ้า (V)
  current     Float    // กระแสไฟฟ้า (A)
  power       Float    // กำลังไฟฟ้า (Watt / kW)
  energyUnits Float    // หน่วยสะสม (kWh)
  recordedAt  DateTime @default(now())
}

// ข้อมูลแจ้งซ่อม
model MaintenanceRequest {
  id          Int      @id @default(autoincrement())
  roomId      Int
  userId      Int
  title       String   // เช่น แอร์ไม่เย็น, ก๊อกน้ำรั่ว
  description String   // รายละเอียด
  imageUrl    String?  // รูปภาพประกอบ
  status      String   @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ==========================================
// ส่วนเพิ่มสำหรับระบบหลังบ้าน (Admin)
// ==========================================

// ห้องพัก (dormId ตรงกับ id ใน frontend: tt1..tt4)
model Room {
  id        Int       @id @default(autoincrement())
  dormId    String
  floor     Int
  code      String    @unique   // เช่น A101
  capacity  Int       @default(4)
  status    String    @default("AVAILABLE") // AVAILABLE, MAINTENANCE, CLOSED
  bookings  Booking[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

// การจอง + การชำระเงิน
model Booking {
  id            Int       @id @default(autoincrement())
  roomId        Int
  room          Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId        Int?
  studentName   String
  studentCode   String?
  phone         String?
  parentName    String?
  parentPhone   String?
  status        String    @default("PENDING") // PENDING, CONFIRMED, CANCELLED
  paymentStatus String    @default("UNPAID")  // UNPAID, PAID
  paymentAmount Int       @default(1999)
  paymentMethod String?
  receiptNo     String?
  paidAt        DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}
