generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  email     String   @unique
  password  String
  name      String?
  role      String   @default("USER")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ข้อมูลการใช้ไฟฟ้า (รองรับ Real-time)
model PowerUsage {
  id          Int      @id @default(autoincrement())
  roomId      Int
  voltage     Float    // แรงดันไฟฟ้า (V)
  current     Float    // กระแสไฟฟ้า (A)
  power       Float    // กำลังไฟฟ้า (Watt / kW)
  energyUnits Float    // หน่วยสะสม (kWh)
  recordedAt  DateTime @default(now())
}

// ข้อมูลแจ้งซ่อม
model MaintenanceRequest {
  id          Int      @id @default(autoincrement())
  roomId      Int
  userId      Int
  title       String   // เช่น แอร์ไม่เย็น, ก๊อกน้ำรั่ว
  description String   // รายละเอียด
  imageUrl    String?  // รูปภาพประกอบ
  status      String   @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ==========================================
// ส่วนเพิ่มสำหรับระบบหลังบ้าน (Admin)
// ==========================================

// ห้องพัก (dormId ตรงกับ id ใน frontend: tt1..tt4)
model Room {
  id        Int       @id @default(autoincrement())
  dormId    String
  floor     Int
  code      String    @unique   // เช่น A101
  capacity  Int       @default(4)
  status    String    @default("AVAILABLE") // AVAILABLE, MAINTENANCE, CLOSED
  bookings  Booking[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

// การจอง + การชำระเงิน
model Booking {
  id            Int       @id @default(autoincrement())
  roomId        Int
  room          Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId        Int?
  studentName   String
  studentCode   String?
  phone         String?
  parentName    String?
  parentPhone   String?
  status        String    @default("PENDING") // PENDING, CONFIRMED, CANCELLED
  paymentStatus String    @default("UNPAID")  // UNPAID, PAID
  paymentAmount Int       @default(999)
  paymentMethod String?
  receiptNo     String?
  paidAt        DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// รีวิวจากนิสิต (1 คน 1 รีวิว)
model Review {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ข้อมูลผู้เช่า (กรอกจากหน้าลงทะเบียน /apply) — 1 บัญชี 1 โปรไฟล์
// เพศใช้คัดกรองอาคาร: Male → tt1, Female → tt2/tt3/tt4
model TenantProfile {
  id                 Int      @id @default(autoincrement())
  userId             Int      @unique
  gender             String   // Male, Female
  dormId             String   // tt1..tt4
  // ข้อมูลตามบัตรประชาชน
  prefix             String
  firstName          String
  lastName           String
  nameEn             String
  citizenId          String
  birthDate          DateTime
  address            String
  // การศึกษา / ประเภทผู้เช่า
  educationLevel     String   // bachelor, master, doctoral, student, general
  school             String?  // สถานศึกษา หรือสถานที่ทำงาน (บุคคลทั่วไป)
  faculty            String?
  studyYear          String?
  // ช่องทางติดต่อ
  mobile             String
  lineId             String?
  contactEmail       String?
  // บุคคลติดต่อฉุกเฉิน 2 ท่าน
  emergencyName      String
  emergencyRelation  String
  emergencyPhone     String
  emergencyAddress   String
  emergency2Name     String
  emergency2Relation String
  emergency2Phone    String
  emergency2Address  String
  // ยานพาหนะ
  vehicleType        String   @default("none") // none, car, motorcycle
  vehicleBrand       String?
  vehicleColor       String?
  vehiclePlate       String?
  vehicleProvince    String?
  // บัตรผู้เช่าดิจิทัล (รูปย่อ JPEG แบบ data URL)
  photo              String?
  keepForNextTerm    Boolean  @default(false) // บันทึกข้อมูลไว้ใช้ลงทะเบียนภาคเรียนถัดไป
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}
