generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                Int                  @id @default(autoincrement())
  username          String               @unique
  email             String               @unique
  password          String
  name              String?
  role              String               @default("USER")
  passwordChangedAt DateTime? // token ที่ออกก่อนเวลานี้ใช้ไม่ได้
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  // ลบบัญชี → ลบโปรไฟล์/รีวิว/แจ้งซ่อม (ข้อมูลส่วนบุคคล) ตามไปด้วย; การจองเก็บไว้เป็นประวัติการเงินแต่ตัดการเชื่อมกับผู้ใช้
  profile           TenantProfile?
  review            Review?
  bookings          Booking[]
  maintenance       MaintenanceRequest[]
}

// ข้อมูลการใช้ไฟฟ้า (รองรับ Real-time)
model PowerUsage {
  id          Int      @id @default(autoincrement())
  roomId      Int
  voltage     Float // แรงดันไฟฟ้า (V)
  current     Float // กระแสไฟฟ้า (A)
  power       Float // กำลังไฟฟ้า (Watt / kW)
  energyUnits Float // หน่วยสะสม (kWh)
  recordedAt  DateTime @default(now())
}

// ข้อมูลแจ้งซ่อม
model MaintenanceRequest {
  id          Int      @id @default(autoincrement())
  roomId      Int // Room.id ของห้องที่ผู้แจ้งพักอยู่ (ข้อมูลเก่าอาจเป็นเลขห้องที่พิมพ์เอง)
  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String // เช่น แอร์ไม่เย็น, ก๊อกน้ำรั่ว
  description String // รายละเอียด
  imageUrl    String? // รูปภาพประกอบ
  status      String   @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

// ==========================================
// ส่วนเพิ่มสำหรับระบบหลังบ้าน (Admin)
// ==========================================

// ห้องพัก (dormId ตรงกับ id ใน frontend: tt1..tt4)
model Room {
  id        Int       @id @default(autoincrement())
  dormId    String
  floor     Int
  code      String    @unique // เช่น A101
  capacity  Int       @default(4)
  status    String    @default("AVAILABLE") // AVAILABLE, MAINTENANCE, CLOSED
  bookings  Booking[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([dormId, floor])
}

// การจอง + การชำระเงิน
model Booking {
  id            Int       @id @default(autoincrement())
  roomId        Int
  // ห้ามลบห้องที่มีการจอง (กันประวัติการชำระเงินหาย) — ปิดห้องด้วย status = CLOSED แทน
  room          Room      @relation(fields: [roomId], references: [id], onDelete: Restrict)
  userId        Int?
  user          User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  studentName   String
  studentCode   String?
  phone         String?
  parentName    String?
  parentPhone   String?
  status        String    @default("PENDING") // PENDING, CONFIRMED, CANCELLED
  paymentStatus String    @default("UNPAID") // UNPAID, PAID
  paymentAmount Int       @default(1999) // ค่าลงทะเบียน (บาท) — backend ใส่ค่าจริงจาก REGISTRATION_FEE ตอนสร้าง
  paymentMethod String?
  receiptNo     String?   @unique
  paidAt        DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([roomId, status])
  @@index([userId, status])
}

// รีวิวจากนิสิต (1 คน 1 รีวิว)
model Review {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ข้อมูลผู้เช่า (กรอกจากหน้าลงทะเบียน /apply) — 1 บัญชี 1 โปรไฟล์
// เพศใช้คัดกรองอาคาร: Male → tt1, Female → tt2/tt3/tt4
model TenantProfile {
  id                 Int      @id @default(autoincrement())
  userId             Int      @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  gender             String // Male, Female
  dormId             String // tt1..tt4
  // ข้อมูลตามบัตรประชาชน
  prefix             String
  firstName          String
  lastName           String
  nameEn             String
  citizenId          String
  birthDate          DateTime
  address            String
  // การศึกษา / ประเภทผู้เช่า
  educationLevel     String // bachelor, master, doctoral, student, general
  school             String? // สถานศึกษา หรือสถานที่ทำงาน (บุคคลทั่วไป)
  faculty            String?
  studyYear          String?
  // ช่องทางติดต่อ
  mobile             String
  lineId             String?
  contactEmail       String?
  // บุคคลติดต่อฉุกเฉิน 2 ท่าน
  emergencyName      String
  emergencyRelation  String
  emergencyPhone     String
  emergencyAddress   String
  emergency2Name     String
  emergency2Relation String
  emergency2Phone    String
  emergency2Address  String
  // ยานพาหนะ
  vehicleType        String   @default("none") // none, car, motorcycle
  vehicleBrand       String?
  vehicleColor       String?
  vehiclePlate       String?
  vehicleProvince    String?
  // บัตรผู้เช่าดิจิทัล (รูปย่อ JPEG แบบ data URL)
  photo              String?
  keepForNextTerm    Boolean  @default(false) // บันทึกข้อมูลไว้ใช้ลงทะเบียนภาคเรียนถัดไป
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}
