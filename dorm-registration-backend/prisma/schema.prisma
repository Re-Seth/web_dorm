generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id             Int                 @id @default(autoincrement())
  username       String              @unique
  email          String              @unique
  password       String
  name           String?
  role           String              @default("USER")
  profile        StudentProfile?
  booking        Booking?
  reviews        Review[]
  maintenanceReq MaintenanceRequest[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
}

model StudentProfile {
  id              Int      @id @default(autoincrement())
  userId          Int      @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  prefix          String   @default("")
  firstName       String   @default("")
  lastName        String   @default("")
  citizenId       String   @default("")
  phone           String   @default("")
  fatherPrefix    String   @default("")
  fatherFirstName String   @default("")
  fatherLastName  String   @default("")
  fatherPhone     String   @default("")
  motherPrefix    String   @default("")
  motherFirstName String   @default("")
  motherLastName  String   @default("")
  motherPhone     String   @default("")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Dorm {
  id     String @id
  name   String
  gender String
  floors Int
  rooms  Room[]
}

model Room {
  id       String    @id
  dormId   String
  dorm     Dorm      @relation(fields: [dormId], references: [id], onDelete: Cascade)
  code     String
  floor    Int
  capacity Int       @default(4)
  bookings Booking[]
}

model Booking {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  roomId    String
  room      Room     @relation(fields: [roomId], references: [id])
  status    String   @default("CONFIRMED")
  payment   Payment?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Payment {
  id        Int      @id @default(autoincrement())
  bookingId Int      @unique
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  receiptNo String   @unique
  amount    Float    @default(1999)
  method    String   @default("qr")
  status    String   @default("PAID")
  paidAt    DateTime @default(now())
}

model MaintenanceRequest {
  id          Int      @id @default(autoincrement())
  roomId      Int
  userId      Int?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  title       String
  description String
  imageUrl    String?
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PowerUsage {
  id          Int      @id @default(autoincrement())
  roomId      Int
  voltage     Float
  current     Float
  power       Float
  energyUnits Float
  recordedAt  DateTime @default(now())
}

model Review {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
}